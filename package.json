{
  "name": "cary-food-journey",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-generated-food.mjs && vite",
    "build": "node scripts/build-generated-food.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude 'e2e/**'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "security": "npm audit --audit-level=moderate",
    "quality:arab-users": "vitest run src/arabUserScenarios.test.tsx src/uxUserJourney.test.tsx src/targetedCheckInPhase.test.tsx src/arabicUserJourney.test.tsx src/arabicFoodNames.test.ts",
    "quality:deploy": "npm run typecheck && npm run lint && npm run quality:arab-users && npm test",
    "test:e2e": "playwright test e2e",
    "test:visual": "npm run test:e2e"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.2.3",
    "vitest": "^5.0.5"
  }
}
